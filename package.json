{
  "name": "fishxcode-docs",
  "version": "0.0.68",
  "private": true,
  "description": "FishXCode 文档站：Fumadocs + Next.js 静态导出，部署在 Cloudflare Pages",
  "homepage": "https://docs.fishxcode.com",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "preview": "wrangler pages dev out",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "deploy:cf": "pnpm build && wrangler pages deploy out --project-name fishxcode-docs --branch main",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "cn": "^0.5.2",
    "fumadocs-core": "16.19.6",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.6",
    "lucide-react": "^1.71.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-markdown": "2.2.4",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "takumi-js": "^2.22.1",
    "zbsearch": "^4.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  }
}
