{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path((?!\\.well-known(?:/|$)).*)",
      "has": [{ "type": "host", "value": { "eq": "doc.fishxcode.com" } }],
      "destination": "https://docs.fishxcode.com/:path",
      "statusCode": 308
    },
    { "source": "/feed.xml", "destination": "/rss.xml", "statusCode": 301 },
    { "source": "/feed.atom", "destination": "/rss.xml", "statusCode": 301 },
    {
      "source": "/subscription-plans/:plan(claude|codex|by-number-of-times){.html}?",
      "destination": "/subscription-plans",
      "statusCode": 301
    },
    {
      "source": "/:locale(en|fr|es|pt|ru|ja|vi|zh-TW)/subscription-plans/:plan(claude|codex|by-number-of-times){.html}?",
      "destination": "/:locale/subscription-plans",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/api/pricing", "destination": "https://fishxcode.com/api/pricing" },
    { "source": "/api/status-data/status", "destination": "https://status.fishxcode.com/api/v1/status" },
    { "source": "/api/status-data/perf-summary", "destination": "https://fishxcode.com/api/perf-metrics/summary?hours=24" },
    { "source": "/api/status-data/perf-model", "destination": "https://fishxcode.com/api/perf-metrics?hours=24" },
    { "source": "/api/status-data/pricing", "destination": "https://fishxcode.com/api/pricing" },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/llms.mdx/index/content.md"
    },
    { "source": "/:path+.md", "destination": "/llms.mdx/:path+/content.md" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "</llms.txt>; rel=\"service-doc\", </ai.txt>; rel=\"service-desc\", </status>; rel=\"describedby\", </sitemap.xml>; rel=\"describedby\", </.well-known/api-catalog>; rel=\"api-catalog\", </.well-known/ai-catalog.json>; rel=\"describedby\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/.well-known/:path((?!llms\\.txt$).*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/api/pricing",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Accept" },
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=60" },
        { "key": "Vary", "value": "Origin" }
      ]
    },
    {
      "source": "/api/status-data/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Accept" },
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=60" },
        { "key": "Vary", "value": "Origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/static.json/:locale",
      "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }]
    },
    {
      "source": "/:dir(og|img)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/:locale(en|fr|es|pt|ru|ja|vi|zh-TW)?/rss.xml",
      "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }]
    },
    {
      "source": "/:file(llms|llms-full).txt",
      "headers": [{ "key": "Content-Language", "value": "zh-CN" }]
    },
    {
      "source": "/:locale(en|fr|es|ru|ja|vi|zh-TW)/:file(llms|llms-full).txt",
      "headers": [{ "key": "Content-Language", "value": ":locale" }]
    },
    {
      "source": "/pt/:file(llms|llms-full).txt",
      "headers": [{ "key": "Content-Language", "value": "pt-BR" }]
    },
    {
      "source": "/llms.mdx/:path((?!(?:en|fr|es|pt|ru|ja|vi|zh-TW)/).+)",
      "headers": [{ "key": "Content-Language", "value": "zh-CN" }]
    },
    {
      "source": "/llms.mdx/:locale(en|fr|es|ru|ja|vi|zh-TW)/:path+",
      "headers": [{ "key": "Content-Language", "value": ":locale" }]
    },
    {
      "source": "/llms.mdx/pt/:path+",
      "headers": [{ "key": "Content-Language", "value": "pt-BR" }]
    },
    {
      "source": "/:path((?!(?:en|fr|es|pt|ru|ja|vi|zh-TW|llms\\.mdx)/).+).md",
      "headers": [{ "key": "Content-Language", "value": "zh-CN" }]
    },
    {
      "source": "/:locale(en|fr|es|ru|ja|vi|zh-TW)/:path+.md",
      "headers": [{ "key": "Content-Language", "value": ":locale" }]
    },
    {
      "source": "/pt/:path+.md",
      "headers": [{ "key": "Content-Language", "value": "pt-BR" }]
    },
    {
      "source": "/llms.mdx/index/content.md",
      "headers": [{ "key": "Link", "value": "</>; rel=\"canonical\", </llms.txt>; rel=\"describedby\"" }]
    },
    {
      "source": "/llms.mdx/:locale(en|fr|es|pt|ru|ja|vi|zh-TW)/index/content.md",
      "headers": [{ "key": "Link", "value": "</:locale>; rel=\"canonical\", </:locale/llms.txt>; rel=\"describedby\"" }]
    },
    {
      "source": "/llms.mdx/:path((?!(?:en|fr|es|pt|ru|ja|vi|zh-TW)/|index/content\\.md$).+)/content.md",
      "headers": [{ "key": "Link", "value": "</:path>; rel=\"canonical\", </llms.txt>; rel=\"describedby\"" }]
    },
    {
      "source": "/llms.mdx/:locale(en|fr|es|pt|ru|ja|vi|zh-TW)/:path((?!index/content\\.md$).+)/content.md",
      "headers": [
        { "key": "Link", "value": "</:locale/:path>; rel=\"canonical\", </:locale/llms.txt>; rel=\"describedby\"" }
      ]
    },
    {
      "source": "/index.md",
      "headers": [{ "key": "Link", "value": "</>; rel=\"canonical\", </llms.txt>; rel=\"describedby\"" }]
    },
    {
      "source": "/:locale(en|fr|es|pt|ru|ja|vi|zh-TW)/index.md",
      "headers": [{ "key": "Link", "value": "</:locale>; rel=\"canonical\", </:locale/llms.txt>; rel=\"describedby\"" }]
    },
    {
      "source": "/:path((?!(?:en|fr|es|pt|ru|ja|vi|zh-TW|llms\\.mdx)/|index\\.md$).+).md",
      "headers": [{ "key": "Link", "value": "</:path>; rel=\"canonical\", </llms.txt>; rel=\"describedby\"" }]
    },
    {
      "source": "/:locale(en|fr|es|pt|ru|ja|vi|zh-TW)/:path((?!index\\.md$).+).md",
      "headers": [
        { "key": "Link", "value": "</:locale/:path>; rel=\"canonical\", </:locale/llms.txt>; rel=\"describedby\"" }
      ]
    }
  ]
}
